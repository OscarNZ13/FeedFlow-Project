@using FF.Architecture.Parsers
@model IEnumerable<NewsItemDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-folder-fill text-warning me-2"></i>Noticias en la colección</h2>
    <a asp-controller="Collection" asp-action="Index" class="btn btn-outline-primary">Volver a colecciones</a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Esta colección aún no tiene noticias.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-sm border-0 h-100 rounded-4">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" style="height:230px; object-fit:cover;" alt="@item.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@item.Title</h5>
                        <p class="card-text text-muted flex-grow-1">@item.Description</p>
                        <div class="mb-3"><span class="badge bg-primary">@item.SourceName</span></div>
                        <div class="d-flex gap-2 align-items-center">
                            <form asp-controller="Favorite" asp-action="Add" method="post">
                                <input name="sourceItemId" type="hidden" value="@item.SourceItemId" />
                                <button class="btn btn-outline-danger btn-sm" title="Agregar a favoritos">
                                    <i class="bi bi-heart"></i> Favoritos
                                </button>
                            </form>
                            <form asp-controller="Collection" asp-action="RemoveItem" method="post">
                                <input name="sourceItemId" type="hidden" value="@item.SourceItemId" />
                                <input name="collectionId" type="hidden" value="@ViewBag.CollectionId" />
                                <button class="btn btn-outline-secondary btn-sm" title="Quitar de colección">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                            @if (!string.IsNullOrWhiteSpace(item.Url))
                            {
                                <a href="@item.Url" target="_blank" class="btn btn-outline-primary btn-sm ms-auto">Ver original</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
