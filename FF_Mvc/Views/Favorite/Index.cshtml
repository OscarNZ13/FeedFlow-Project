@using FF.Architecture.Parsers
@model IEnumerable<NewsItemDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-heart-fill text-danger me-2"></i>Mis favoritos</h2>
    <a asp-controller="Feed" asp-action="Index" class="btn btn-outline-primary">Volver al feed</a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Aún no tienes noticias favoritas.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-sm border-0 h-100 rounded-4">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" style="height:230px; object-fit:cover;" alt="@item.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@item.Title</h5>
                        <p class="card-text text-muted flex-grow-1">@item.Description</p>
                        <div class="mb-3"><span class="badge bg-primary">@item.SourceName</span></div>
                        <div class="d-flex gap-2 align-items-center">
                            <form asp-action="Like" method="post"><input name="sourceItemId" type="hidden" value="@item.SourceItemId" /><button class="btn btn-danger btn-sm" title="Dar like y mover al inicio"><i class="bi bi-heart-fill"></i> Like</button></form>
                            <form asp-action="Remove" method="post"><input name="sourceItemId" type="hidden" value="@item.SourceItemId" /><button class="btn btn-outline-secondary btn-sm" title="Quitar de favoritos"><i class="bi bi-trash"></i></button></form>
                            @if (!string.IsNullOrWhiteSpace(item.Url))
                            {
                                <a href="@item.Url" target="_blank" class="btn btn-outline-primary btn-sm ms-auto">Ver original</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

