@model FF_Mvc.ViewModels.SourceFormViewModel

<h2>📡 Agregar Fuente</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="AddSource" method="post" class="mb-4" style="max-width: 600px;">
    <div class="mb-3">
        <label asp-for="Url" class="form-label">URL de la fuente</label>
        <input asp-for="Url" class="form-control" placeholder="https://ejemplo.com/api/noticias" />
        <span asp-validation-for="Url" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nombre</label>
        <input asp-for="Name" class="form-control" placeholder="BBC News RSS" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Descripción (opcional)</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="ComponentType" class="form-label">Tipo</label>
        <select asp-for="ComponentType" class="form-select">
            <option value="feed">feed</option>
            <option value="api">api</option>
            <option value="widget">widget</option>
        </select>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RequiresSecret" class="form-check-input" id="requiresSecret" />
        <label class="form-check-label" for="requiresSecret">Esta fuente necesita una API key</label>
    </div>

    <div id="secretFields" class="border rounded p-3 mb-3">
        <div class="mb-3">
            <label asp-for="SecretKeyName" class="form-label">Nombre de la key/header</label>
            <input asp-for="SecretKeyName" class="form-control" placeholder="X-Api-Key" />
        </div>
        <div class="mb-3">
            <label asp-for="SecretKeyValue" class="form-label">Valor de la key</label>
            <input asp-for="SecretKeyValue" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="SecretLocation" class="form-label">Dónde se envía</label>
            <select asp-for="SecretLocation" class="form-select">
                <option value="0">Header</option>
                <option value="1">Query string</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary rounded-pill">
        <i class="bi bi-check-circle me-2"></i>Guardar fuente
    </button>
    <a asp-action="Sources" class="btn btn-outline-secondary rounded-pill">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const checkbox = document.getElementById('requiresSecret');
        const secretFields = document.getElementById('secretFields');
        function toggleSecretFields() {
            secretFields.style.display = checkbox.checked ? 'block' : 'none';
        }
        checkbox.addEventListener('change', toggleSecretFields);
        toggleSecretFields();
    </script>
}
