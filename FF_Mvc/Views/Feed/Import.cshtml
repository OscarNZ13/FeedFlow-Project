@{
    ViewData["Title"] = "Importar noticia";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row justify-content-center">

    <div class="col-lg-6 col-md-8">

        <div class="card shadow border-0 rounded-4">

            <div class="card-body p-5">

                <div class="text-center mb-4">

                    <i class="bi bi-cloud-arrow-up-fill text-primary"
                       style="font-size:4rem;"></i>

                    <h2 class="mt-3 mb-2">
                        Importar noticia
                    </h2>

                    <p class="text-muted mb-0">
                        Seleccione un archivo JSON para importar la noticia a Feedflow.

                </div>

                <form asp-action="Import"
                      method="post"
                      enctype="multipart/form-data">

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Archivo JSON
                        </label>

                        <input id="jsonFile"
                               type="file"
                               name="file"
                               class="form-control"
                               accept=".json"
                               required />

                        <div class="form-text">
                            Solo se permiten archivos con extensión <strong>.json</strong>.
                        </div>

                    </div>

                    <div id="selectedFile"
                         class="alert alert-light border d-none">

                        <i class="bi bi-file-earmark-code text-primary me-2"></i>

                        <span></span>

                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left"></i>

                            Volver

                        </a>

                        <button id="btnImport"
                                class="btn btn-primary">

                            <i class="bi bi-upload me-2"></i>

                            Importar

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts{

<script>

const input = document.getElementById("jsonFile");
const selected = document.getElementById("selectedFile");
const selectedText = selected.querySelector("span");
const button = document.getElementById("btnImport");

input.addEventListener("change", function () {

    if (this.files.length > 0) {

        selected.classList.remove("d-none");
        selectedText.innerText = this.files[0].name;

    }
    else{

        selected.classList.add("d-none");

    }

});

document.querySelector("form").addEventListener("submit", function () {

    button.disabled = true;

    button.innerHTML =
        '<span class="spinner-border spinner-border-sm me-2"></span>Importando...';

});

</script>

}

<style>

#jsonFile{

    border:2px dashed #cfd4da;

    padding:25px;

    cursor:pointer;

}

#jsonFile:hover{

    border-color:#0d6efd;

}

</style>