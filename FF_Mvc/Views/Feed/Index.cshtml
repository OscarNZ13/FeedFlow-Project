@using FF.Architecture.Parsers
@model IEnumerable<NewsItemDto>
<p>Total noticias: @ViewBag.Total</p>

@{
    var roleIdClaim = User.FindFirst("roleId");
    var isAdmin = roleIdClaim != null && roleIdClaim.Value == "1";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["Error"]

        <button class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2 class="mb-0">
        📰 Feed de Noticias
    </h2>

     @if (isAdmin)
    {
        <a asp-controller="Feed"
           asp-action="Import"
           class="btn btn-primary shadow-sm rounded-pill">

            <i class="bi bi-upload me-2"></i>
            Importar noticia (JSON)

        </a>
    }

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay noticias disponibles por ahora.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-sm border-0 h-100 rounded-4">

                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             class="card-img-top"
                             style="height:230px; object-fit:cover;"
                             alt="@item.Title" />
                    }

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start">

                            <h5 class="card-title fw-bold"
                                style="
                                display:-webkit-box;
                                -webkit-line-clamp:2;
                                -webkit-box-orient:vertical;
                                overflow:hidden;">
                                @item.Title
                            </h5>

                            <a href="javascript:void(0)"
                               onclick="downloadNews(@item.SourceItemId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Title))')"
                               class="text-success ms-2"
                               title="Descargar JSON">

                                <i class="bi bi-download fs-4"></i>

                            </a>

                        </div>

                        <p class="card-text text-muted flex-grow-1"
                           style="
                            display:-webkit-box;
                            -webkit-line-clamp:3;
                            -webkit-box-orient:vertical;
                            overflow:hidden;">
                            @item.Description
                        </p>

                        <div class="mb-3">

                            <span class="badge bg-primary">
                                @item.SourceName
                            </span>

                            @if (!string.IsNullOrWhiteSpace(item.Category))
                            {
                                <span class="badge bg-secondary">
                                    @item.Category
                                </span>
                            }

                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-auto">

                            @if (item.PublishedAt != null)
                            {
                                <small class="text-muted">
                                    @item.PublishedAt.Value.ToString("dd/MM/yyyy")
                                </small>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.Url))
                            {
                                <a href="@item.Url"
                                   target="_blank"
                                   class="btn btn-outline-primary btn-sm">

                                    Ver original

                                </a>
                            }

                        </div>

                    </div>

                </div>
            </div>
            }
    </div>
}
                
        <div class="modal fade" id="downloadModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-file-earmark-arrow-down me-2"></i>
                            Descargar noticia
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body">

                        <p>¿Desea descargar la siguiente noticia?</p>

                        <div class="p-3 rounded bg-light border">
                            <i class="bi bi-file-earmark-text text-primary me-2"></i>
                            <h6 id="newsTitle" class="mb-0 fw-bold"></h6>
                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="button"
                                class="btn btn-success"
                                id="confirmDownload">

                            <i class="bi bi-download"></i>
                            Descargar

                        </button>

                    </div>

                </div>

            </div>
        </div>

@section Scripts {

<script>

    let selectedNewsId = 0;
    let downloadModal;

    function downloadNews(id, title) {

        selectedNewsId = id;

        document.getElementById("newsTitle").innerText = title;

        downloadModal = new bootstrap.Modal(
            document.getElementById("downloadModal")
        );

        downloadModal.show();
    }

    document
        .getElementById("confirmDownload")
        .addEventListener("click", function () {

            downloadModal.hide();

            setTimeout(() => {
                window.location.href = "/Feed/Download/" + selectedNewsId;
            }, 250);

        });

</script>

}

<style>

.card{
    transition:transform .2s ease, box-shadow .2s ease;
}

.card:hover{
    transform:translateY(-5px);
    box-shadow:0 .75rem 1.5rem rgba(0,0,0,.15)!important;
}

.text-success i{
    transition:transform .2s ease;
}

.text-success:hover i{
    transform:scale(1.2);
}
</style>