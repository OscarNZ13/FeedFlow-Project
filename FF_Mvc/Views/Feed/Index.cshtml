@using FF.Architecture.Parsers
@model IEnumerable<NewsItemDto>

<h2>Feed de Noticias</h2>

@if (!Model.Any())
{
    <p>No hay noticias disponibles por ahora.</p>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>
                        <p class="text-muted small">@item.SourceName @(item.Category != null ? $"· {item.Category}" : "")</p>
                        @if (!string.IsNullOrWhiteSpace(item.Url))
                        {
                            <a href="@item.Url" target="_blank" class="btn btn-sm btn-outline-primary">Ver original</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
