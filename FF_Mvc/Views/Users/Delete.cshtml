@model FF_Mvc.ViewModels.UserViewModel
@{
    ViewData["Title"] = "Eliminar Usuario";
}

<div class="ff-card">
    <div class="ff-masthead">
        <div class="ff-masthead-title">FeedFlow</div>
        <div class="ff-masthead-sub">Administración de usuarios</div>
    </div>

    <div class="ff-divider">
        <div class="ff-divider-line"></div>
        <div class="ff-divider-text">Eliminar Usuario</div>
        <div class="ff-divider-line"></div>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

    <dl class="row ff-dl">
        <dt class="col-sm-2 ff-label">Id</dt>
        <dd class="col-sm-10 ff-text">@Model.Id</dd>

        <dt class="col-sm-2 ff-label">Nombre</dt>
        <dd class="col-sm-10 ff-text">@Model.Username</dd>

        <dt class="col-sm-2 ff-label">Correo</dt>
        <dd class="col-sm-10 ff-text">@Model.Email</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />

        
        <div class="form-actions">
            <button type="submit" class="ff-btn ff-btn-danger">Eliminar</button>
            <a asp-action="Index" class="ff-btn ff-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

