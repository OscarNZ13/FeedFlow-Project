@model FF_Mvc.ViewModels.EditInfoViewModel
@{
    ViewData["Title"] = "Editar Información";
}

<div class="ff-card">
    <div class="ff-masthead">
        <div class="ff-masthead-title">FeedFlow</div>
        <div class="ff-masthead-sub">Administración de usuarios</div>
    </div>

    <div class="ff-divider">
        <div class="ff-divider-line"></div>
        <div class="ff-divider-text">Editar Información</div>
        <div class="ff-divider-line"></div>
    </div>

    <form asp-action="EditInfo" method="post">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Username" class="ff-label">Username</label>
            <input asp-for="Username" class="form-control" placeholder="" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="ff-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="ff-label">Rol</label>
            <select asp-for="RoleId" class="form-control">
                <option value="">-- Seleccione un rol --</option>
                <option value="1">Administrador</option>
                <option value="2">Usuario</option>
            </select>
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>

       
        <div class="form-actions">
            <button type="submit" class="ff-btn ff-btn-primary">Guardar</button>
            <a asp-action="Index" class="ff-btn ff-btn-secondary">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
