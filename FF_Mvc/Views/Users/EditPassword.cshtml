@model FF_Mvc.ViewModels.EditPasswordViewModel
@{
    ViewData["Title"] = "Editar Contraseña";
}

<div class="ff-card">
    <div class="ff-masthead">
        <div class="ff-masthead-title">FeedFlow</div>
        <div class="ff-masthead-sub">Administración de usuarios</div>
    </div>

    <div class="ff-divider">
        <div class="ff-divider-line"></div>
        <div class="ff-divider-text">Editar Contraseña</div>
        <div class="ff-divider-line"></div>
    </div>

    <form asp-action="EditPassword" method="post">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="NewPassword" class="ff-label">Nueva Contraseña</label>
            <input asp-for="NewPassword" type="password" class="form-control" placeholder="" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword" class="ff-label">Confirmar Contraseña</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

       
        <div class="form-actions">
            <button type="submit" class="ff-btn ff-btn-primary">Guardar</button>
            <a asp-action="Index" class="ff-btn ff-btn-secondary">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

